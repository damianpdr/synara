{
  "expo": {
    "name": "Synara",
    "slug": "synara-mobile",
    "owner": "artifex123",
    "version": "0.8.3",
    "orientation": "portrait",
    "scheme": "synara",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.synara.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan a Synara pairing QR code to connect to your server.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.synara.mobile"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d45181c-e337-48b4-abf7-a0c1828c2acb"
      }
    }
  }
}
